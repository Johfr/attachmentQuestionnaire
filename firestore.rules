rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Questionnaire sessions — written by server (admin SDK bypasses rules),
    // readable by the owning user only.
    match /questionnaireSessions/{sessionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false; // server-only writes via admin SDK

      match /aiExchange/{docId} {
        allow read: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/questionnaireSessions/$(sessionId)).data.uid;
        allow write: if false;
      }
    }

    // Blog articles — public read, server-only writes.
    match /contactRequests/{requestId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false; // server-only writes via /api/contact
    }

    match /articles/{articleId} {
      allow read: if true;
      allow write: if false;
    }

    match /customers/{uid} {
      allow read: if request.auth.uid == uid;

      match /checkout_sessions/{id} {
        allow read, write: if request.auth.uid == uid;
      }
      match /subscriptions/{id} {
        allow read: if request.auth.uid == uid;
      }
      match /payments/{id} {
        allow read: if request.auth.uid == uid;
      }
    }

    match /products/{id} {
      allow read: if true;

      match /prices/{id} {
        allow read: if true;
      }

      match /tax_rates/{id} {
        allow read: if true;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
