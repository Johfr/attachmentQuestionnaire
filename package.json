{
  "name": "nuxt-front",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "postbuild": "node -e \"const fs=require('fs'),p=JSON.parse(fs.readFileSync('.output/server/package.json','utf8'));delete p.dependencies['@img/sharp-win32-x64'];fs.writeFileSync('.output/server/package.json',JSON.stringify(p,null,2)+'\\n')\"",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt"
  },
  "dependencies": {
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/icon": "2.2.1",
    "@nuxt/image": "2.0.0",
    "@nuxt/test-utils": "4.0.0",
    "@nuxtjs/sitemap": "^8.0.11",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "0.11.3",
    "chart.js": "^4.5.1",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.7.0",
    "nuxt": "^4.4.2",
    "nuxt-charts": "2.1.3",
    "nuxt-lucide-icons": "^2.0.0",
    "vue": "^3.5.30",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "sass-embedded": "^1.98.0",
    "tailwindcss": "^3.4.19",
    "vitest": "^4.1.0"
  }
}
