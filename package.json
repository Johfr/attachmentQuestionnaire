{
  "name": "nuxt-front",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build:nuxt": "nuxt build",
    "build:raw": "npm run build:nuxt && npm run postbuild:ssr",
    "build": "npm run build:prod",
    "build:test": "node scripts/with-env.mjs .env.test npm run build:raw",
    "build:prod": "node scripts/with-env.mjs .env.prod npm run build:raw",
    "postbuild:ssr": "node -e \"const fs=require('fs');const cp=require('child_process');const root=JSON.parse(fs.readFileSync('package.json','utf8'));const serverDir='.output/server';const serverPath=serverDir+'/package.json';const server=JSON.parse(fs.readFileSync(serverPath,'utf8'));delete server.dependencies['@img/sharp-win32-x64'];server.dependencies['firebase-admin']=root.dependencies['firebase-admin'];server.dependencies['firebase-functions']=root.dependencies['firebase-functions'];server.engines={...(server.engines||{}),node:'22'};fs.writeFileSync(serverPath,JSON.stringify(server,null,2)+'\\n');fs.writeFileSync(serverDir+'/.npmrc','legacy-peer-deps=true\\n');fs.rmSync(serverDir+'/node_modules',{recursive:true,force:true});fs.rmSync(serverDir+'/package-lock.json',{force:true});cp.execSync('npm install --package-lock-only --ignore-scripts --legacy-peer-deps',{cwd:serverDir,stdio:'inherit'})\"",
    "dev:raw": "nuxt dev",
    "dev": "npm run dev:prod",
    "dev:test": "node scripts/with-env.mjs .env.test npm run dev:raw",
    "dev:prod": "node scripts/with-env.mjs .env.prod npm run dev:raw",
    "firebase:use:prod": "npx firebase-tools use prod",
    "firebase:use:test": "npx firebase-tools use test",
    "deploy": "npm run deploy:prod",
    "deploy:test": "npm run firebase:use:test && node scripts/with-env.mjs .env.test npx firebase-tools deploy",
    "deploy:prod": "npm run firebase:use:prod && node scripts/with-env.mjs .env.prod npx firebase-tools deploy",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt"
  },
  "dependencies": {
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/icon": "2.2.1",
    "@nuxt/image": "2.0.0",
    "@nuxt/test-utils": "4.0.0",
    "@nuxtjs/sitemap": "^8.0.11",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "0.11.3",
    "chart.js": "^4.5.1",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.2.2",
    "nuxt": "^4.4.2",
    "nuxt-charts": "2.1.3",
    "nuxt-lucide-icons": "^2.0.0",
    "vue": "^3.5.30",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.8.9",
    "sass-embedded": "^1.98.0",
    "tailwindcss": "^3.4.19",
    "vitest": "^4.1.0"
  }
}
